#!/usr/bin/env bash
# aria2ctl — on-demand lifecycle wrapper for the aria2 RPC daemon.
#
# Design rule: nothing stays resident. The daemon is not enabled at boot, it is
# started when something is actually queued, and aria2-idle.timer stops it once
# the queue drains. AriaNg is the single-file all-in-one build, so the web UI
# needs no server at all — it opens over file://.
#
# Connection settings, in order of precedence:
#   ARIA2_RPC_HOST / ARIA2_RPC_PORT / ARIA2_RPC_SECRET  (environment)
#   rpc-listen-port= / rpc-secret= in $ARIA2_CONF
#   127.0.0.1 / 6800 / no secret
#
# The bar widget passes its own host/port/secret through the environment, so the
# widget and this helper cannot end up talking to different daemons.

set -euo pipefail

ARIA2_CONF="${ARIA2_CONF:-${HOME}/.config/aria2/aria2.conf}"
UNIT=aria2.service
IDLE_TIMER=aria2-idle.timer
ARIANG="${HOME}/.local/share/ariang/index.html"

conf_value() {
  # conf_value <key> -> value, or empty. Ignores comments and surrounding space.
  [ -f "$ARIA2_CONF" ] || return 0
  sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\(.*\)$/\1/p" "$ARIA2_CONF" \
    | tail -n1 | sed 's/[[:space:]]*$//'
}

RPC_HOST="${ARIA2_RPC_HOST:-127.0.0.1}"
RPC_PORT="${ARIA2_RPC_PORT:-$(conf_value rpc-listen-port)}"
RPC_PORT="${RPC_PORT:-6800}"
RPC_SECRET="${ARIA2_RPC_SECRET:-$(conf_value rpc-secret)}"
RPC_URL="http://${RPC_HOST}:${RPC_PORT}/jsonrpc"

# Every request is built and sent by python3 rather than assembled as a string.
# Interpolating a URI into a JSON body is a real injection: a crafted clipboard
# value could otherwise close the string and inject arbitrary aria2 options such
# as dir/out, which is an arbitrary file write as this user.
#
# Exit codes let callers tell the cases apart, which matters because an
# authentication failure must never be mistaken for an empty queue:
#   0 ok (prints the result as JSON)   4 unreachable
#   5 rpc error, e.g. unauthorized     6 malformed response
rpc_call() {
  local method="$1"; shift
  python3 -c '
import json, sys, urllib.request, urllib.error

url, secret, method = sys.argv[1], sys.argv[2], sys.argv[3]
args = sys.argv[4:]

params = []
if secret:
    params.append("token:" + secret)
if method == "aria2.addUri":
    params.append(args)          # aria2.addUri takes a list of URIs

body = json.dumps({"jsonrpc": "2.0", "id": "aria2ctl",
                   "method": method, "params": params}).encode()
req = urllib.request.Request(url, data=body,
                             headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(req, timeout=5) as r:
        out = json.load(r)
except urllib.error.HTTPError as e:          # reachable, but refused the call
    try:
        out = json.load(e)
    except Exception:
        sys.exit(6)
except Exception:                            # refused/timeout: daemon is down
    sys.exit(4)

if isinstance(out, dict) and out.get("error"):
    print(out["error"].get("message", "rpc error"), file=sys.stderr)
    sys.exit(5)
print(json.dumps(out.get("result")))
' "$RPC_URL" "$RPC_SECRET" "$method" "$@"
}

# 0 = reachable and authorized. Note this is deliberately stricter than "the
# port is open": a daemon that rejects our token is not one we can manage.
rpc_up() { rpc_call aria2.getVersion >/dev/null 2>&1; }

stop_idle_timer() { systemctl --user stop "$IDLE_TIMER" 2>/dev/null || true; }

cmd_up() {
  if rpc_up; then return 0; fi
  systemctl --user start "$UNIT"
  for _ in $(seq 1 50); do
    rpc_up && return 0
    sleep 0.1
  done
  echo "aria2ctl: daemon did not come up within 5s (check: systemctl --user status ${UNIT})" >&2
  return 1
}

cmd_down() {
  systemctl --user stop "$UNIT" 2>/dev/null || true
  # PartOf= propagates stop, but only when a stop job actually runs. Belt and
  # braces so the timer can never outlive the daemon.
  stop_idle_timer
}

cmd_add() {
  [ $# -ge 1 ] || { echo "usage: aria2ctl add <uri> [uri...]" >&2; return 2; }
  local uri had=0
  for uri in "$@"; do
    # An empty clipboard yields an empty argument; queueing it just produces a
    # confusing aria2 error.
    [ -n "${uri//[[:space:]]/}" ] || continue
    had=1
  done
  [ "$had" -eq 1 ] || { echo "aria2ctl: nothing to add (empty clipboard?)" >&2; return 2; }

  cmd_up
  for uri in "$@"; do
    [ -n "${uri//[[:space:]]/}" ] || continue
    if ! rpc_call aria2.addUri "$uri" >/dev/null; then
      echo "aria2ctl: failed to queue: $uri" >&2
      return 1
    fi
  done
}

cmd_status() {
  local result rc=0
  result="$(rpc_call aria2.getGlobalStat 2>/dev/null)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    # Fail closed. Reporting 0/0 for an auth failure would let idle-check stop a
    # daemon that is busy downloading.
    printf '{"up":false,"ok":false,"numActive":0,"numWaiting":0,"downloadSpeed":0,"error":%s}\n' \
      "$([ "$rc" -eq 5 ] && echo '"unauthorized"' || echo '"unreachable"')"
    return 0
  fi
  printf '%s' "$result" | python3 -c '
import json, sys
try:
    r = json.load(sys.stdin) or {}
except Exception:
    r = {}
print(json.dumps({
    "up": True, "ok": True,
    "numActive": int(r.get("numActive", 0)),
    "numWaiting": int(r.get("numWaiting", 0)),
    "downloadSpeed": int(r.get("downloadSpeed", 0)),
}))'
}

cmd_idle_check() {
  # If the daemon is not answering, there is nothing to stop — but the timer
  # itself must go, or a failed start leaves it firing every 5 minutes forever
  # against nothing, which is exactly what this design exists to avoid.
  if ! rpc_up; then
    stop_idle_timer
    exit 0
  fi

  local s active waiting ok
  s="$(cmd_status)"
  ok="$(printf '%s' "$s" | python3 -c 'import json,sys; print(json.load(sys.stdin)["ok"])')"
  [ "$ok" = "True" ] || exit 0      # never act on an error response

  active="$(printf '%s' "$s" | python3 -c 'import json,sys; print(json.load(sys.stdin)["numActive"])')"
  waiting="$(printf '%s' "$s" | python3 -c 'import json,sys; print(json.load(sys.stdin)["numWaiting"])')"
  if [ "$active" -eq 0 ] && [ "$waiting" -eq 0 ]; then
    logger -t aria2ctl "queue empty — stopping ${UNIT}"
    cmd_down
  fi
}

cmd_ui() {
  [ -f "$ARIANG" ] || { echo "aria2ctl: AriaNg not found at $ARIANG" >&2; return 1; }
  cmd_up
  # Single-file AriaNg build: no HTTP server, opened straight off disk.
  xdg-open "file://${ARIANG}" >/dev/null 2>&1 &
}

case "${1:-}" in
  up)         shift; cmd_up ;;
  down)       shift; cmd_down ;;
  add)        shift; cmd_add "$@" ;;
  status)     shift; cmd_status ;;
  idle-check) shift; cmd_idle_check ;;
  ui)         shift; cmd_ui ;;
  *)
    cat >&2 <<'EOF'
usage: aria2ctl <command>

  up           start the daemon if it is not already running
  down         stop the daemon (and its idle timer)
  add <uri>    start the daemon if needed, then queue a URI
  status       print {"up","ok",numActive,numWaiting,downloadSpeed} as JSON
  idle-check   stop the daemon if the queue is empty (used by the timer)
  ui           open AriaNg over file:// (no web server involved)

environment:
  ARIA2_RPC_HOST, ARIA2_RPC_PORT, ARIA2_RPC_SECRET, ARIA2_CONF
EOF
    exit 2 ;;
esac
